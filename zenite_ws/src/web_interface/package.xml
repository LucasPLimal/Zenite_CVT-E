<?xml version="1.0"?>
<package format="3">
  <name>web_interface</name>
  <version>0.1.0</version>
  <description>Interface web do Zênite: backend FastAPI (HTTP + WebSocket) + nó ponte ROS 2 (rclpy)</description>

  <maintainer email="voce@exemplo.com">Você</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>image_adjust_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <!-- opencv-contrib-python (via pip), NÃO python3-opencv nem opencv-python:
       o rastreamento do robô usa cv2.TrackerCSRT, que só existe no módulo
       "tracking" do opencv_contrib. Ver README para instruções de instalação
       e por que não pode coexistir com outras variantes do pacote opencv. -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-jinja2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
